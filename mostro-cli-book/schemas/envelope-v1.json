{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mostro.network/cli/envelope-v1.json",
  "title": "mostro-cli outcome envelope, contract version 1 (any command)",
  "description": "Hand-written by the mostro-cli book, not generated by the CLI. It accepts the outcome of every command, including legacy commands rejected with output_not_supported and invocations whose command could not be resolved. The per-command schemas in this folder are stricter; prefer them when the command is known.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "status", "data", "error", "warnings", "meta"],
  "properties": {
    "schema_version": { "const": "1" },
    "command": {
      "description": "Canonical dotted command name such as order.list; schema for discovery; null when the command could not be resolved.",
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "status": { "enum": ["ok", "error", "uncertain"] },
    "data": { "description": "Command-specific object on ok; null on error; object or null on uncertain." },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "invalid_arguments", "output_not_supported",
                "configuration_missing", "configuration_invalid",
                "relay_connection_failed", "relay_read_failed",
                "read_timeout", "read_limit_exceeded", "internal_error",
                "identity_missing", "identity_unreadable",
                "protocol_unsupported", "pow_required", "request_rejected",
                "reply_timeout", "node_refused", "reply_malformed",
                "order_declined", "order_not_saved", "store_unwritable",
                "order_unknown", "store_unreadable"
              ]
            },
            "message": { "type": "string", "description": "Fixed English prose chosen by the code. Never match on it." },
            "reason": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "description": "Only on node_refused." }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "enum": [
              "invalid_event_timestamp", "cleanup_incomplete",
              "orders_not_returned", "invalid_order_timestamp",
              "local_status_stale", "trade_keys_limited",
              "trade_index_not_recorded"
            ]
          },
          "message": { "type": "string" }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication", "daemon_acceptance", "persistence", "snapshot"],
      "properties": {
        "publication": { "enum": ["not_attempted", "unknown", "published", "not_applicable"] },
        "daemon_acceptance": { "enum": ["unknown", "accepted", "rejected", "not_applicable"] },
        "persistence": { "enum": ["not_attempted", "applied", "failed", "not_applicable"] },
        "snapshot": { "type": ["object", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ok" } } },
      "then": { "properties": { "data": { "type": "object" }, "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "error" } } },
      "then": { "properties": { "data": { "type": "null" }, "error": { "type": "object" } } }
    },
    {
      "if": { "properties": { "status": { "const": "uncertain" } } },
      "then": { "properties": { "data": { "type": ["object", "null"] }, "error": { "type": "object" } } }
    }
  ]
}
