{
  "$defs": {
    "ChatRecord": {
      "description": "One message of the conversation.",
      "properties": {
        "created_at": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at_unix": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/ChatSender"
        },
        "message_id": {
          "description": "The id of the signed message inside the envelope: the same on every\nrelay that delivers it.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "text": {
          "description": "What was written: untrusted data, at most 4096 bytes, cut on a\ncharacter boundary.",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "from",
        "created_at",
        "created_at_unix",
        "text"
      ],
      "type": "object"
    },
    "ChatSender": {
      "description": "Who wrote a chat message.",
      "oneOf": [
        {
          "const": "me",
          "description": "The order's trade key: the user.",
          "type": "string"
        },
        {
          "const": "counterparty",
          "description": "The counterparty's trade key.",
          "type": "string"
        }
      ]
    },
    "DaemonAcceptance": {
      "enum": [
        "unknown",
        "accepted",
        "rejected",
        "not_applicable"
      ],
      "type": "string"
    },
    "ErrorCode": {
      "enum": [
        "invalid_arguments",
        "output_not_supported",
        "configuration_missing",
        "configuration_invalid",
        "relay_connection_failed",
        "relay_read_failed",
        "read_timeout",
        "read_limit_exceeded",
        "internal_error",
        "identity_missing",
        "identity_unreadable",
        "store_unreadable",
        "order_unknown"
      ],
      "type": "string"
    },
    "ErrorInfo": {
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ExecutionMeta": {
      "description": "Execution stages and optional snapshot evidence of one outcome.",
      "properties": {
        "daemon_acceptance": {
          "$ref": "#/$defs/DaemonAcceptance"
        },
        "persistence": {
          "$ref": "#/$defs/Persistence"
        },
        "publication": {
          "$ref": "#/$defs/Publication"
        },
        "snapshot": {
          "type": "null"
        }
      },
      "required": [
        "publication",
        "daemon_acceptance",
        "persistence",
        "snapshot"
      ],
      "type": "object"
    },
    "MessagePayload": {
      "description": "A summary of the payload of a message. A consumer treats a payload whose\n`kind` it does not know as opaque and reads only its `kind`.",
      "oneOf": [
        {
          "description": "The message carries none.",
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "order",
              "type": "string"
            },
            "order": {
              "$ref": "#/$defs/OrderRecord"
            }
          },
          "required": [
            "kind",
            "order"
          ],
          "type": "object"
        },
        {
          "properties": {
            "amount": {
              "maxLength": 20,
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "type": [
                "string",
                "null"
              ]
            },
            "invoice": {
              "description": "The invoice to pay (or the one the node holds); data for the caller.",
              "type": "string"
            },
            "kind": {
              "const": "payment_request",
              "type": "string"
            },
            "order": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OrderRecord"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The order the invoice is for, when the node sent it."
            }
          },
          "required": [
            "kind",
            "order",
            "invoice",
            "amount"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "bond_payout_request",
              "type": "string"
            },
            "order": {
              "$ref": "#/$defs/OrderRecord"
            },
            "slashed_at": {
              "description": "When the node recorded the slash.",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
              "type": [
                "string",
                "null"
              ]
            },
            "slashed_at_unix": {
              "maxLength": 20,
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "order",
            "slashed_at",
            "slashed_at_unix"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "cant_do",
              "type": "string"
            },
            "reason": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "counterparty_pubkey": {
              "type": "string"
            },
            "kind": {
              "const": "peer",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "counterparty_pubkey"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "amount": {
              "maxLength": 20,
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "type": "string"
            },
            "kind": {
              "const": "amount",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "amount"
          ],
          "type": "object"
        },
        {
          "description": "The node could not pay the buyer's invoice. It retries on its own and\nasks for a new invoice (`add-invoice`) only when every attempt fails.\nWith no attempt left (`payment_attempts` \"0\") it neither retries nor\nasks, and the record's `next_step` is `add_invoice`. Sent once per\nbuyer invoice: on the first failed payout to it, and again after a\nreplacement invoice resets the count; never updated in between.",
          "properties": {
            "kind": {
              "const": "payment_failed",
              "type": "string"
            },
            "payment_attempts": {
              "description": "How many more times the node will try to pay, as of this message\n(mostrod v0.20.2 sends its setting minus one).",
              "maxLength": 20,
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "type": "string"
            },
            "payment_retries_interval": {
              "description": "Seconds between two attempts.",
              "maxLength": 20,
              "pattern": "^(0|-?[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "payment_attempts",
            "payment_retries_interval"
          ],
          "type": "object"
        },
        {
          "description": "Any other payload, by variant name only. The name is informative, not a\nstable identifier: a later executable may give that payload a kind of\nits own.",
          "properties": {
            "kind": {
              "const": "other",
              "type": "string"
            },
            "variant": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "variant"
          ],
          "type": "object"
        }
      ]
    },
    "MessageRecord": {
      "description": "One message of the node to one of the user's trade keys.",
      "properties": {
        "action": {
          "description": "The wire name of the action.",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "type": "string"
        },
        "created_at": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at_unix": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "event_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "next_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextStep"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the message asked the user to do when the node sent it; null when\nit asks nothing. A consumer treats a value it does not know as null."
        },
        "order_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "$ref": "#/$defs/MessagePayload"
        },
        "request_id": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "trade_index": {
          "description": "The index of the key the message was addressed to; null when unknown.",
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "trade_pubkey": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "created_at",
        "created_at_unix",
        "order_id",
        "request_id",
        "action",
        "next_step",
        "trade_index",
        "trade_pubkey",
        "payload"
      ],
      "type": "object"
    },
    "NextStep": {
      "description": "What the node asks the user to do next, for the messages that ask.",
      "oneOf": [
        {
          "const": "pay_bond_invoice",
          "description": "Pay the bond invoice in the payload.",
          "type": "string"
        },
        {
          "const": "add_invoice",
          "description": "Send an invoice for the order: `order add-invoice`. Also after a failed\npayout that the node will not retry.",
          "type": "string"
        },
        {
          "const": "pay_hold_invoice",
          "description": "Pay the hold invoice in the payload.",
          "type": "string"
        },
        {
          "const": "add_bond_invoice",
          "description": "Send a payout invoice for a slashed bond: `bond add-invoice`.",
          "type": "string"
        },
        {
          "const": "fiat_sent",
          "description": "Send the fiat, then `order fiat-sent`. Sent to the buyer once the\nseller's hold invoice is paid; act only while the order is `active`.",
          "type": "string"
        },
        {
          "const": "rate",
          "description": "Rate the counterparty: `order rate`. Sent to both sides when the trade\nis over.",
          "type": "string"
        }
      ]
    },
    "OrderRecord": {
      "description": "One of the user's orders as the node returned it.",
      "properties": {
        "buyer_trade_pubkey": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at_unix": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at_unix": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "fiat_amount": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "fiat_amount_max": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "fiat_amount_min": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": [
            "string",
            "null"
          ]
        },
        "fiat_currency": {
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "payment_method": {
          "type": "string"
        },
        "premium_percent": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "sats_amount": {
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        },
        "seller_trade_pubkey": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "side": {
          "enum": [
            "buy",
            "sell",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "active",
            "canceled",
            "canceled-by-admin",
            "settled-by-admin",
            "completed-by-admin",
            "dispute",
            "expired",
            "fiat-sent",
            "settled-hold-invoice",
            "pending",
            "success",
            "waiting-buyer-invoice",
            "waiting-payment",
            "waiting-taker-bond",
            "waiting-maker-bond",
            "cooperatively-canceled",
            "in-progress",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "side",
        "status",
        "sats_amount",
        "fiat_currency",
        "fiat_amount",
        "fiat_amount_min",
        "fiat_amount_max",
        "payment_method",
        "premium_percent",
        "buyer_trade_pubkey",
        "seller_trade_pubkey",
        "created_at",
        "created_at_unix",
        "expires_at",
        "expires_at_unix"
      ],
      "type": "object"
    },
    "Persistence": {
      "enum": [
        "not_attempted",
        "applied",
        "failed",
        "not_applicable"
      ],
      "type": "string"
    },
    "Publication": {
      "enum": [
        "not_attempted",
        "unknown",
        "published",
        "not_applicable"
      ],
      "type": "string"
    },
    "Warning": {
      "properties": {
        "code": {
          "$ref": "#/$defs/WarningCode"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "WarningCode": {
      "enum": [
        "invalid_event_timestamp",
        "cleanup_incomplete"
      ],
      "type": "string"
    },
    "Warnings": {
      "description": "Warnings of one outcome, at most one per code.",
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "type": "array"
    },
    "WatchData": {
      "description": "One `order.watch` result: the document of a JSON call, or one update of a\nhuman watch.",
      "properties": {
        "chat": {
          "description": "The new chat messages, oldest first, each once by its `message_id`.",
          "items": {
            "$ref": "#/$defs/ChatRecord"
          },
          "type": "array"
        },
        "counterparty_pubkey": {
          "description": "The counterparty's trade key; null while the chat is not followed.",
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "description": "Pass it back verbatim with `--after` to get only newer records.",
          "maxLength": 13020,
          "pattern": "^(0|[1-9][0-9]{0,19})(:[0-9a-f]{64}(,[0-9a-f]{64})*)?$",
          "type": "string"
        },
        "ended": {
          "description": "One of the messages ended the trade.",
          "type": "boolean"
        },
        "messages": {
          "description": "The node's new messages about the order, oldest first.",
          "items": {
            "$ref": "#/$defs/MessageRecord"
          },
          "type": "array"
        },
        "order_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "truncated": {
          "description": "Older records may be missing: a relay's replay reached its limit.",
          "type": "boolean"
        }
      },
      "required": [
        "order_id",
        "counterparty_pubkey",
        "messages",
        "chat",
        "ended",
        "truncated",
        "cursor"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "command": {
          "const": "order.watch"
        },
        "data": {
          "$ref": "#/$defs/WatchData"
        },
        "error": {
          "type": "null"
        },
        "meta": {
          "$ref": "#/$defs/ExecutionMeta",
          "properties": {
            "daemon_acceptance": {
              "const": "not_applicable"
            },
            "persistence": {
              "const": "not_applicable"
            },
            "publication": {
              "const": "not_applicable"
            },
            "snapshot": {
              "type": "null"
            }
          }
        },
        "status": {
          "const": "ok"
        }
      },
      "title": "success"
    },
    {
      "properties": {
        "command": {
          "const": "order.watch"
        },
        "data": {
          "type": "null"
        },
        "error": {
          "allOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            }
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_arguments",
                "configuration_missing",
                "configuration_invalid",
                "identity_missing",
                "identity_unreadable",
                "store_unreadable",
                "order_unknown",
                "relay_connection_failed",
                "relay_read_failed",
                "read_timeout",
                "read_limit_exceeded",
                "internal_error"
              ]
            }
          }
        },
        "meta": {
          "$ref": "#/$defs/ExecutionMeta",
          "properties": {
            "daemon_acceptance": {
              "const": "not_applicable"
            },
            "persistence": {
              "const": "not_applicable"
            },
            "publication": {
              "const": "not_applicable"
            },
            "snapshot": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "status": {
          "const": "error"
        }
      },
      "title": "failure of the resolved command"
    },
    {
      "properties": {
        "command": {
          "type": "null"
        },
        "data": {
          "type": "null"
        },
        "error": {
          "allOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            }
          ],
          "properties": {
            "code": {
              "const": "invalid_arguments"
            }
          }
        },
        "meta": {
          "$ref": "#/$defs/ExecutionMeta",
          "properties": {
            "daemon_acceptance": {
              "const": "unknown"
            },
            "persistence": {
              "const": "not_attempted"
            },
            "publication": {
              "const": "not_attempted"
            },
            "snapshot": {
              "type": "null"
            }
          }
        },
        "status": {
          "const": "error"
        }
      },
      "title": "failure before the command was resolved"
    }
  ],
  "properties": {
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "meta": {
      "$ref": "#/$defs/ExecutionMeta"
    },
    "schema_version": {
      "const": "1"
    },
    "status": {
      "enum": [
        "ok",
        "error"
      ]
    },
    "warnings": {
      "$ref": "#/$defs/Warnings"
    }
  },
  "required": [
    "schema_version",
    "command",
    "status",
    "data",
    "error",
    "warnings",
    "meta"
  ],
  "title": "order.watch outcome",
  "type": "object"
}
